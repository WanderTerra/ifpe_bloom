---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with IFPÊ Bloom to talk about your data strategy, dashboards, or digital transformation goals."
>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Let's start with a conversation, not a proposal</h1>
      <p class="page-intro__lede">
        Tell us a little about your business and what's not working. We'll
        get back to you to arrange an initial call — no obligation, no sales
        script.
      </p>
    </div>
  </section>

  <section class="section contact">
    <div class="container contact__grid">
      <form
        class="contact-form"
        name="contact"
        method="POST"
        action="https://formspree.io/f/your-form-id"
      >
        <!--
          TODO: replace the action above with your real form endpoint
          (e.g. a Formspree form ID, or your hosting provider's forms
          integration) before launch.
        -->
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="button button--primary">Send message</button>
      </form>

      <aside class="contact-info">
        <div class="contact-info__block">
          <p class="eyebrow">Email</p>
          <a href="mailto:hello@ifpebloom.com">hello@ifpebloom.com</a>
        </div>
        <div class="contact-info__block">
          <p class="eyebrow">Based in</p>
          <p>London, United Kingdom</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--color-surface-alt);
  }

  .page-intro__lede {
    max-width: 38rem;
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: var(--space-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 32rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7em 0.9em;
    border: var(--border-hairline);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .contact-form .button {
    align-self: flex-start;
    margin-top: var(--space-2xs);
  }

  .contact-info {
    border-left: var(--border-hairline);
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-info__block a,
  .contact-info__block p {
    font-family: var(--font-display);
    font-size: 1rem;
    margin: 0;
    text-decoration: none;
  }

  .contact-info__block a:hover {
    color: var(--color-accent-alt);
  }

  @media (max-width: 780px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }

    .contact-info {
      border-left: none;
      padding-left: 0;
      border-top: var(--border-hairline);
      padding-top: var(--space-md);
    }
  }
</style>
