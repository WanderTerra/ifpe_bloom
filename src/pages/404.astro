---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist — let's get you back on track.">
  <section class="section not-found">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p>It may have moved, or the link might be out of date.</p>
      <a href="/" class="button button--primary">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .not-found p {
    max-width: 30rem;
    margin-inline: auto;
    color: var(--color-text-muted);
  }

  .not-found .button {
    margin-top: var(--space-sm);
  }
</style>
